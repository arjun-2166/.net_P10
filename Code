using Microsoft.AspNetCore.Mvc;
using Microsoft.Data.SqlClient;
using StudentManagementAPI.Models;
 
namespace StudentManagementAPI.Controllers
{
    [ApiController]
    [Route("api/[controller]")]
    public class StudentsController : ControllerBase
    {
        private readonly string _connStr;
 
        public StudentsController(IConfiguration config)
        {
            _connStr = config.GetConnectionString("StudentDB")!;
        }
 
        // GET: api/students  (Read all)
        [HttpGet]
        public IActionResult GetAll()
        {
            var list = new List<Student>();
 
            using (var con = new SqlConnection(_connStr))
            {
                var cmd = new SqlCommand("SELECT StudentId, Name, Email, Course, Age FROM Students", con);
                con.Open();
                using (var dr = cmd.ExecuteReader())
                {
                    while (dr.Read())
                    {
                        list.Add(ReadStudent(dr));
                    }
                }
            }
            return Ok(list);
        }
 
        // GET: api/students/1  (Read one)
        [HttpGet("{id}")]
        public IActionResult GetById(int id)
        {
            using (var con = new SqlConnection(_connStr))
            {
                var cmd = new SqlCommand(
                    "SELECT StudentId, Name, Email, Course, Age FROM Students WHERE StudentId=@id", con);
                cmd.Parameters.AddWithValue("@id", id);
                con.Open();
                using (var dr = cmd.ExecuteReader())
                {
                    if (dr.Read())
                    {
                        return Ok(ReadStudent(dr));
                    }
                }
            }
            return NotFound($"Student with id {id} not found.");
        }
 
        // POST: api/students  (Create)
        [HttpPost]
        public IActionResult Create(Student s)
        {
            int newId;
            using (var con = new SqlConnection(_connStr))
            {
                var cmd = new SqlCommand(
                    "INSERT INTO Students (Name, Email, Course, Age) " +
                    "OUTPUT INSERTED.StudentId VALUES (@name, @email, @course, @age)", con);
                FillParameters(cmd, s);
                con.Open();
                newId = (int)cmd.ExecuteScalar();
            }
            s.StudentId = newId;
            return CreatedAtAction(nameof(GetById), new { id = newId }, s);
        }
 
        // PUT: api/students/1  (Update)
        [HttpPut("{id}")]
        public IActionResult Update(int id, Student s)
        {
            int rows;
            using (var con = new SqlConnection(_connStr))
            {
                var cmd = new SqlCommand(
                    "UPDATE Students SET Name=@name, Email=@email, Course=@course, Age=@age " +
                    "WHERE StudentId=@id", con);
                FillParameters(cmd, s);
                cmd.Parameters.AddWithValue("@id", id);
                con.Open();
                rows = cmd.ExecuteNonQuery();
            }
            if (rows == 0)
            {
                return NotFound($"Student with id {id} not found.");
            }
            s.StudentId = id;
            return Ok(s);
        }
 
        // DELETE: api/students/1  (Delete)
        [HttpDelete("{id}")]
        public IActionResult Delete(int id)
        {
            int rows;
            using (var con = new SqlConnection(_connStr))
            {
                var cmd = new SqlCommand("DELETE FROM Students WHERE StudentId=@id", con);
                cmd.Parameters.AddWithValue("@id", id);
                con.Open();
                rows = cmd.ExecuteNonQuery();
            }
            if (rows == 0)
            {
                return NotFound($"Student with id {id} not found.");
            }
            return NoContent();
        }
 
        // ---------- Helpers ----------
        private static Student ReadStudent(SqlDataReader dr)
        {
            return new Student
            {
                StudentId = dr.GetInt32(0),
                Name = dr.GetString(1),
                Email = dr.GetString(2),
                Course = dr.GetString(3),
                Age = dr.GetInt32(4)
            };
        }
 
        private static void FillParameters(SqlCommand cmd, Student s)
        {
            cmd.Parameters.AddWithValue("@name", s.Name);
            cmd.Parameters.AddWithValue("@email", s.Email);
            cmd.Parameters.AddWithValue("@course", s.Course);
            cmd.Parameters.AddWithValue("@age", s.Age);
        }
    }
}
